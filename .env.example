# Copy this file to .env and fill in the values. Never commit .env.

# Weights & Biases key. Used by the training command to register the
# models and by the API to download them. Never hardcode it.
WANDB_API_KEY=

# Optional. W&B entity (user or team). Leave it commented to use the default.
# WANDB_ENTITY=

# Optional. W&B project of the models. Defaults to outlier-detector.
# OUTLIER_WANDB_PROJECT=outlier-detector

# Tickers loaded into memory when the API starts, separated by commas.
# OUTLIER_TICKERS=AAPL,PETR4.SA
